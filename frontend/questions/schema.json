{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SATQuestionBank",
  "type": "object",
  "required": ["metadata", "questions"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["id", "title", "category", "totalQuestions", "generatedAt"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "enum": ["Information & Ideas", "Craft & Structure", "Expression of Ideas", "Standard English Conventions", "Algebra", "Advanced Math", "Problem Solving & Data Analysis", "Geometry & Trigonometry", "Mixed"] },
        "totalQuestions": { "type": "integer", "minimum": 1 },
        "timeLimitMinutes": { "type": "integer", "minimum": 1 },
        "source": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "passage", "question", "options", "answer"],
        "properties": {
          "id": { "type": "integer", "minimum": 1 },
          "passage": { "type": "string" },
          "question": { "type": "string", "minLength": 1 },
          "options": {
            "type": "object",
            "required": ["A", "B", "C", "D"],
            "properties": {
              "A": { "type": "string", "minLength": 1 },
              "B": { "type": "string", "minLength": 1 },
              "C": { "type": "string", "minLength": 1 },
              "D": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "answer": { "type": "string", "enum": ["A", "B", "C", "D"] },
          "explanation": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}